{
  "name": "@bali/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "migrate": "tsx scripts/migrate.ts",
    "school": "tsx scripts/school.ts",
    "demo": "NODE_ENV=test tsx scripts/demo.ts",
    "dev:teacher": "tsx scripts/dev-teacher.ts",
    "deck-bucket:check": "tsx scripts/deck-bucket-check.ts",
    "load:seed": "NODE_ENV=development tsx scripts/load/seed.ts",
    "load:serve": "tsx scripts/load/serve.ts",
    "load:gate": "k6 run scripts/load/gate.js",
    "load:sweep": "tsx scripts/load/sweep.ts",
    "fixtures": "UPDATE_FIXTURES=1 vitest run test/contract-fixtures.test.ts test/openapi.test.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@bali/db": "*",
    "@bali/shared": "*",
    "@fastify/cors": "^11.1.0",
    "@sentry/node": "^11.4.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "tsx": "^4.23.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-orm": "^0.45.2",
    "pino-pretty": "^13.1.3"
  }
}
