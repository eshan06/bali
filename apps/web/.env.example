# Bali web (apps/web) — public env. Copy to .env.local for dev; pass the prod values
# as BUILD ARGS to the Docker image (NEXT_PUBLIC_* are inlined at build time, not runtime).
# A production build refuses to start when the required ones are missing (src/lib/env.ts).

# REQUIRED — the API base (include the /v1 suffix).
NEXT_PUBLIC_API_URL=http://localhost:3001/v1

# REQUIRED — Cognito user pool (public identifiers, not secrets).
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
NEXT_PUBLIC_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# REQUIRED — Cognito Hosted-UI domain (enables "Continue with Google"). Without it,
# sign-in silently degrades to email/password only.
NEXT_PUBLIC_COGNITO_DOMAIN=your-app.auth.us-east-1.amazoncognito.com

# OPTIONAL — OAuth redirect target; defaults to <origin>/auth/callback in dev.
NEXT_PUBLIC_REDIRECT_URI=https://app.yourschool.example/auth/callback

# OPTIONAL — canonical site origin (used for robots/sitemap/OpenGraph URLs).
NEXT_PUBLIC_SITE_URL=https://app.yourschool.example

# OPTIONAL — where the marketing "Book a demo" form sends leads.
NEXT_PUBLIC_DEMO_EMAIL=hello@trybali.com

# OPTIONAL — addresses shown on /contact, /terms, and /privacy (sensible fallbacks if unset).
NEXT_PUBLIC_CONTACT_EMAIL=hello@trybali.com
NEXT_PUBLIC_PRIVACY_EMAIL=privacy@trybali.com

# OPTIONAL — App Store / TestFlight URL for the iOS app. Until set, the desk-tag
# fallback page (/t/[code]) honestly says "coming soon" instead of a dead link.
NEXT_PUBLIC_APP_STORE_URL=

# DEV ONLY — enables the "Dev sign-in" auth bypass. NEVER set to 1 for a real build;
# a production build hard-fails when this is 1 (src/lib/env.ts).
NEXT_PUBLIC_ALLOW_DEV_TOKENS=0
