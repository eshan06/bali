# Bali API configuration. Copy to .env for local dev; set these in the Railway
# dashboard per environment for deploys. Every variable here is validated at
# boot (apps/api/src/env.ts) — a missing or malformed one fails fast.

# development | test | production. Unset defaults to production (safe logging).
NODE_ENV=development

# The API binds this. Railway injects PORT; locally 3001 is the default.
PORT=3001
HOST=0.0.0.0

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# How long a graceful shutdown waits for in-flight requests before exiting (ms).
# Must sit below the platform's SIGTERM->SIGKILL window; on Railway set
# RAILWAY_DEPLOYMENT_DRAINING_SECONDS above this.
SHUTDOWN_DEADLINE_MS=8000

# The school's time zone. Bell times and armed-tap "end of the school day"
# expiry compute against server-local time; Railway defaults to UTC, so set it.
TZ=America/Chicago

# Postgres. Railway provides this for a managed Postgres plugin.
DATABASE_URL=postgres://user:password@localhost:5432/bali

# AWS Cognito. AUTH_ISSUER is the pool's issuer URL; AUTH_JWKS_URI is its JWKS
# endpoint (usually <issuer>/.well-known/jwks.json); AUTH_AUDIENCE lists the
# pool's app client ids, comma-separated — the portal's and the phone's (one id
# alone accepts just that client) — each matched against an access token's
# client_id (only access tokens are accepted).
AUTH_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
AUTH_JWKS_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX/.well-known/jwks.json
AUTH_AUDIENCE=your-web-client-id,your-phone-client-id

# Shared secret the backup sweep cron presents to /internal/sweep (the API
# sweeps every minute itself; the cron runs every 5 minutes, hosting decision 3).
# Generate a long random value (e.g. `openssl rand -hex 32`); at least 32 chars, or the API will not boot.
INTERNAL_API_KEY=change-me-to-a-long-random-secret

# Error monitoring (Sentry). Unset = off; leave it unset in dev and tests.
# When set, a 500 or a crash is reported scrubbed of student data
# (apps/api/src/monitoring.ts). SENTRY_ENVIRONMENT names the environment
# (dev, production); unset, NODE_ENV.
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=dev

# The "class started" push (APNs, apps/api/src/push/apns.ts). Unset = off;
# leave it unset in dev and tests. All three or none: the .p8 key's contents
# (newlines may be written \n), its key id, and the team id. APNS_TOPIC is the
# bundle id; unset, com.bali.Bali.
# APNS_KEY_P8="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APNS_KEY_ID=ABC123DEFG
# APNS_TEAM_ID=H535678UF8
# APNS_TOPIC=com.bali.Bali
