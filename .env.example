# Bali v2 — backend env (apps/api + packages/db scripts). Copy to .env at the repo
# root and fill from real values (see legacy/.env for the working originals).
# NEVER commit the real .env.

# Postgres — same RDS instance as legacy, but the v2 database (bali_v2)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/bali_v2?sslmode=require

# AWS Cognito (shared with legacy — public identifiers, not secrets)
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# API
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Single-school MVP (UUID; reuse legacy value)
DEFAULT_SCHOOL_ID=11111111-1111-1111-1111-111111111111

# The seeded demo teacher (Ms. Rivera) is adoptable by the real Cognito account
# with this email — first teacher sign-in with it claims the demo classes.
SEED_TEACHER_EMAIL=you@example.com
