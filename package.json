{
  "name": "bali",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^22"
  },
  "//": "overrides.postcss patches the vulnerable copy Next 15 pins; retire the override when the Next 16 migration lands (docs/PLAN.md decision log, 2026-09-20). overrides.@esbuild-kit/core-utils lifts drizzle-kit's dev-only esbuild 0.18 (via @esbuild-kit) onto the hoisted patched one, past GHSA-67mh-4wv8-2f99 (docs/DECISIONS.md, 2026-10-05); retire it when drizzle-kit drops @esbuild-kit.",
  "overrides": {
    "postcss": "^8.5.23",
    "@esbuild-kit/core-utils": {
      "esbuild": ">=0.25.0"
    }
  },
  "scripts": {
    "dev:api": "npm run dev -w @bali/api",
    "start": "npm start -w @bali/api",
    "migrate": "npm run migrate -w @bali/api",
    "school": "npm run school -w @bali/api --",
    "demo": "npm run demo -w @bali/api",
    "dev:teacher": "npm run dev:teacher -w @bali/api --",
    "load:seed": "npm run load:seed -w @bali/api",
    "load:serve": "npm run load:serve -w @bali/api",
    "load:gate": "npm run load:gate -w @bali/api --",
    "load:sweep": "npm run load:sweep -w @bali/api",
    "fixtures": "npm run fixtures -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm test -ws --if-present && npm run test:infra",
    "test:infra": "node --test 'infra/**/*.test.mjs'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
