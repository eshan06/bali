{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ecc@ecc": false
  },
  "permissions": {
    "deny": [
      "Bash(gh pr *--add-label*)",
      "Bash(gh pr *--remove-label*)",
      "Bash(gh pr create *--label*)",
      "Bash(gh issue *--add-label*)",
      "Bash(gh issue *--remove-label*)",
      "Bash(gh issue create *--label*)",
      "Bash(gh label *)",
      "Bash(gh pr *--admin*)",
      "Bash(gh api */labels*-X*)",
      "Bash(gh api *-X*/labels*)",
      "Bash(gh api */labels*--method*)",
      "Bash(gh api *--method*/labels*)",
      "Bash(gh api */labels*-f*)",
      "Bash(gh api *-f*/labels*)",
      "Bash(gh api */labels*-F*)",
      "Bash(gh api *-F*/labels*)",
      "Bash(gh api */labels*--input*)",
      "Bash(gh api *--input*/labels*)",
      "Bash(gh api */rulesets*-X*)",
      "Bash(gh api *-X*/rulesets*)",
      "Bash(gh api */rulesets*--method*)",
      "Bash(gh api *--method*/rulesets*)",
      "Bash(gh api */rulesets*-f*)",
      "Bash(gh api *-f*/rulesets*)",
      "Bash(gh api */rulesets*-F*)",
      "Bash(gh api *-F*/rulesets*)",
      "Bash(gh api */rulesets*--input*)",
      "Bash(gh api *--input*/rulesets*)",
      "Bash(gh api */protection*-X*)",
      "Bash(gh api *-X*/protection*)",
      "Bash(gh api */protection*--method*)",
      "Bash(gh api *--method*/protection*)",
      "Bash(gh api */protection*-f*)",
      "Bash(gh api *-f*/protection*)",
      "Bash(gh api */protection*-F*)",
      "Bash(gh api *-F*/protection*)",
      "Bash(gh api */protection*--input*)",
      "Bash(gh api *--input*/protection*)",
      "Bash(gh api *Labelable*)",
      "Bash(gh api *createLabel*)",
      "Bash(gh api *updateLabel*)",
      "Bash(gh api *deleteLabel*)",
      "Bash(gh api *createRepositoryRuleset*)",
      "Bash(gh api *updateRepositoryRuleset*)",
      "Bash(gh api *deleteRepositoryRuleset*)",
      "Bash(gh api *createBranchProtectionRule*)",
      "Bash(gh api *updateBranchProtectionRule*)",
      "Bash(gh api *deleteBranchProtectionRule*)"
    ]
  }
}
