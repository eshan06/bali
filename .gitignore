# Secrets and local config — never commit these
.env
.env.*
!.env.example
.env-archive/

# Local tooling and OS noise — but shared repo commands/skills ARE tracked
.claude/*
!.claude/commands/
!.claude/skills/
!.claude/agents/
!.claude/hooks/
!.claude/settings.json
!.claude/CLAUDE.md
.DS_Store

# Dependencies and build output (regenerable)
node_modules/
dist/
build/
.next/
next-env.d.ts
coverage/
*.tsbuildinfo
# SwiftPM's (ios/BaliCore), and the package state Xcode keeps beside it
.build/
.swiftpm/
# XcodeGen writes it from ios/project.yml, which is the project (ios/README.md)
ios/Bali.xcodeproj/

# graphify knowledge graph — regenerable (`graphify update .`), stays local
graphify-out/
