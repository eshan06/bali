<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Core NFC: tag reading for Bali check-in (NFCTagReaderSession → "TAG"). -->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>NDEF</string>
		<string>TAG</string>
	</array>
	<!-- Screen Time / app shielding during Focus Mode. Requires Apple approval
	     for App Store distribution; works for development on a paid team. -->
	<key>com.apple.developer.family-controls</key>
	<true/>
</dict>
</plist>
