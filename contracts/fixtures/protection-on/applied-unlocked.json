{
  "endpoint": "POST /v1/sessions/{id}/protection-on",
  "scenario": "Screen Time back on after an unlock recorded while it was off: still unlocked, never relocked.",
  "request": {
    "path": "/v1/sessions/00000000-0000-7000-8000-000000000001/protection-on",
    "body": {
      "eventId": "00000000-0000-7000-8000-000000000002",
      "deviceTime": "2000-01-01T00:01:00.000Z"
    }
  },
  "status": 200,
  "type": "ProtectionOnResponse",
  "body": {
    "outcome": "applied",
    "state": "unlocked",
    "session": {
      "id": "00000000-0000-7000-8000-000000000001",
      "classId": "00000000-0000-7000-8000-000000000003",
      "endsAt": "2000-01-01T00:02:00.000Z"
    }
  },
  "disposition": "apply_session"
}
