{
  "endpoint": "POST /v1/sessions/{id}/refocus",
  "scenario": "A late refocus (A13), made before an unlock the server already has, its request outliving the phone’s wait: recorded, never applied, answered as its retry is.",
  "request": {
    "path": "/v1/sessions/00000000-0000-7000-8000-000000000001/refocus",
    "body": {
      "eventId": "00000000-0000-7000-8000-000000000002",
      "deviceTime": "2000-01-01T00:01:00.000Z",
      "order": {
        "install": "00000000-0000-7000-8000-000000000003",
        "seq": 3
      }
    }
  },
  "status": 200,
  "type": "RefocusResponse",
  "body": {
    "outcome": "replay",
    "state": "unlocked",
    "session": {
      "id": "00000000-0000-7000-8000-000000000001",
      "classId": "00000000-0000-7000-8000-000000000004",
      "endsAt": "2000-01-01T00:02:00.000Z"
    }
  },
  "disposition": "apply_session"
}
