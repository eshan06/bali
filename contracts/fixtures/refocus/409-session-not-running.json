{
  "endpoint": "POST /v1/sessions/{id}/refocus",
  "scenario": "A refocus after the session ended.",
  "request": {
    "path": "/v1/sessions/00000000-0000-7000-8000-000000000001/refocus",
    "body": {
      "eventId": "00000000-0000-7000-8000-000000000002",
      "deviceTime": "2000-01-01T00:01:00.000Z"
    }
  },
  "status": 409,
  "type": "ApiErrorBody",
  "body": {
    "error": {
      "code": "conflict",
      "reason": "session_not_running",
      "message": "session has ended"
    }
  },
  "disposition": "drop"
}
