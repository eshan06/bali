{
  "endpoint": "POST /v1/sessions/{id}/unlock",
  "scenario": "An unlock under an id the student’s own tap holds (a bug).",
  "request": {
    "path": "/v1/sessions/00000000-0000-7000-8000-000000000001/unlock",
    "body": {
      "eventId": "00000000-0000-7000-8000-000000000002",
      "deviceTime": "2000-01-01T00:01:00.000Z"
    }
  },
  "status": 409,
  "type": "ApiErrorBody",
  "body": {
    "error": {
      "code": "conflict",
      "reason": "event_id_conflict",
      "message": "event_id already used by another event"
    }
  },
  "disposition": "retry_and_surface"
}
