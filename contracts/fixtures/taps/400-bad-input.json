{
  "endpoint": "POST /v1/taps",
  "scenario": "A malformed tap: its eventId is not a UUID.",
  "request": {
    "path": "/v1/taps",
    "body": {
      "tagId": "TAG-fx",
      "eventId": "x",
      "deviceTime": "2000-01-01T00:01:00.000Z"
    }
  },
  "status": 400,
  "type": "ApiErrorBody",
  "body": {
    "error": {
      "code": "bad_input",
      "message": "invalid request",
      "details": [
        {
          "path": "eventId",
          "message": "Invalid UUID"
        }
      ]
    }
  },
  "disposition": "retry_and_surface"
}
