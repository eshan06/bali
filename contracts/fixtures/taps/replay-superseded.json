{
  "endpoint": "POST /v1/taps",
  "scenario": "A late re-tap (A13), stuck at the phone’s retry bound while the unlock after it went first: recorded, never applied, answered as its retry is.",
  "request": {
    "path": "/v1/taps",
    "body": {
      "tagId": "TAG-fx-late-return",
      "eventId": "00000000-0000-7000-8000-000000000001",
      "deviceTime": "2000-01-01T00:01:00.000Z",
      "order": {
        "install": "00000000-0000-7000-8000-000000000002",
        "seq": 4
      }
    }
  },
  "status": 200,
  "type": "TapResponse",
  "body": {
    "outcome": "replay",
    "session": {
      "id": "00000000-0000-7000-8000-000000000003",
      "classId": "00000000-0000-7000-8000-000000000004",
      "endsAt": "2000-01-01T00:02:00.000Z"
    },
    "state": "unlocked"
  },
  "disposition": "apply_session"
}
